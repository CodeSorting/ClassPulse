<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/outline_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="26dp"
        android:gravity="start|center_vertical"
        android:importantForAccessibility="no"
        android:textColor="@color/cp_brand"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/outline_title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cp_outline_input"
        android:gravity="start|center_vertical"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:saveEnabled="false"
        android:textColor="@color/cp_ink"
        android:textColorHint="@color/cp_brand"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/outline_actions"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_cp_icon_button"
        android:scaleType="center"
        android:src="@drawable/ic_cp_more" />
</LinearLayout>
