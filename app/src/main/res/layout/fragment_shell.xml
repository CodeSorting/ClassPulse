<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cp_background"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="24dp"
    >
        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_cp_back"
            android:scaleType="center"
            app:tint="@color/cp_brand"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
        />
        <TextView
            android:id="@+id/screen_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textColor="@color/cp_brand"
            android:textStyle="bold"
            android:maxLines="2"
        />
        <TextView
            android:id="@+id/role_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_cp_chip"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/cp_brand"
        />
    </LinearLayout>
    <TextView
        android:id="@+id/demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="@string/demo_banner"
        android:textSize="12sp"
        android:textColor="@color/cp_brand"
        android:background="@color/cp_mint"
    />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false"
    >
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp"
        />
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_cp_bar_top"
        android:visibility="gone"
    />
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_cp_bar_top"
        android:visibility="gone"
    >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_home"
            style="@style/CpNavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/nav_classes"
            app:icon="@drawable/ic_cp_home"
        />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_records"
            style="@style/CpNavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/nav_records"
            app:icon="@drawable/ic_cp_records"
        />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_settings"
            style="@style/CpNavButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/nav_profile"
            app:icon="@drawable/ic_cp_person"
        />
    </LinearLayout>
</LinearLayout>
