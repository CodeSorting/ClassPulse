<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView android:id="@+id/student_reactions_card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/cp_mint">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="빠른 반응" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/cp_ink"/>
            <TextView android:id="@+id/student_reaction_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/cp_muted"
                android:layout_marginTop="4dp" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="false"><com.google.android.material.button.MaterialButton
            android:id="@+id/student_reaction_understood" style="@style/CpStudentReaction"
            app:icon="@drawable/ic_live_thumb_up"/>
<com.google.android.material.button.MaterialButton
            android:id="@+id/student_reaction_understanding" style="@style/CpStudentReaction"
            app:icon="@drawable/ic_cp_confused" android:layout_marginStart="6dp"/>
<com.google.android.material.button.MaterialButton
            android:id="@+id/student_reaction_speed" style="@style/CpStudentReaction"
            app:icon="@drawable/ic_live_speed" android:layout_marginStart="6dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="false"><com.google.android.material.button.MaterialButton
            android:id="@+id/student_reaction_term" style="@style/CpStudentReaction"
            app:icon="@drawable/ic_live_menu_book"/>
<com.google.android.material.button.MaterialButton
            android:id="@+id/student_reaction_calculation" style="@style/CpStudentReaction"
            app:icon="@drawable/ic_live_calculate" android:layout_marginStart="6dp"/></LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/student_question_caption" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp"
            android:textStyle="bold" android:textColor="@color/cp_ink" android:maxLines="2"/>
        <TextView android:id="@+id/student_question_detail" android:layout_width="wrap_content"
            android:layout_height="40dp" android:paddingHorizontal="8dp" android:gravity="center"
            android:text="자세히 작성" android:textSize="12sp" android:textColor="@color/cp_accent"
            android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <com.google.android.material.button.MaterialButton android:id="@+id/student_question_topic"
            android:layout_width="56dp" android:layout_height="56dp" android:minWidth="0dp"
            android:padding="4dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:textSize="19sp" android:textColor="@color/cp_ink" android:contentDescription="질문할 대주제 선택"
            app:cornerRadius="28dp" app:backgroundTint="@color/cp_surface" app:strokeWidth="1dp"
            app:strokeColor="@color/cp_line" app:icon="@drawable/ic_cp_expand_more"
            app:iconGravity="textEnd" app:iconSize="14dp" app:iconPadding="0dp" app:iconTint="@color/cp_ink"
            app:rippleColor="@color/cp_control_ripple"/>
        <EditText android:id="@+id/student_question_input" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_student_input" android:hint="질문을 입력하세요" android:padding="12dp"
            android:textSize="14sp" android:textColor="@color/cp_ink" android:textColorHint="@color/cp_muted"
            android:maxLines="3" android:gravity="center_vertical" android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend" android:saveEnabled="false" android:contentDescription="빠른 질문 내용"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/student_question_send"
            android:layout_width="52dp" android:layout_height="52dp" android:minWidth="0dp"
            android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:contentDescription="질문 보내기" app:cornerRadius="26dp"
            app:backgroundTint="@color/cp_brand" app:icon="@drawable/ic_live_near_me"
            app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="25dp"
            app:iconTint="@color/cp_surface" app:rippleColor="@color/cp_on_dark_ripple"/>
    </LinearLayout>
</LinearLayout>
