<resources>
    <style
        name="Base.Theme.ClassPulse"
        parent="Theme.Material3.Light.NoActionBar"
    >
        <item name="colorPrimary">@color/cp_brand</item>
        <item name="colorOnPrimary">@color/cp_surface</item>
        <item name="colorSecondary">@color/cp_accent</item>
        <item name="colorSurface">@color/cp_surface</item>
        <item name="colorOnSurface">@color/cp_ink</item>
        <item name="android:colorBackground">@color/cp_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="materialButtonStyle">@style/CpButton</item>
    </style>
    <style
        name="Theme.ClassPulse"
        parent="Base.Theme.ClassPulse"
    />
    <style
        name="CpButton"
        parent="Widget.Material3.Button"
    >
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/cp_control_ripple</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <!-- 하단 3탭: 아이콘 위·글자 아래, 선택된 탭은 민트색 배경과 브랜드색으로 표시 -->
    <style
        name="CpNavButton"
        parent="Widget.Material3.Button.TextButton"
    >
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/cp_nav_content</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">2dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/cp_nav_content</item>
        <item name="backgroundTint">@color/cp_nav_indicator</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/cp_control_ripple</item>
    </style>
</resources>
