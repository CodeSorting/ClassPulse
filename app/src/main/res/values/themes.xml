<resources>
    <style
        name="Base.Theme.ClassPulse"
        parent="Theme.Material3.Light.NoActionBar"
    >
        <item name="colorPrimary">@color/cp_brand</item>
        <item name="colorOnPrimary">@color/cp_surface</item>
        <item name="colorSecondary">@color/cp_accent</item>
        <item name="colorSurface">@color/cp_surface</item>
        <item name="colorOnSurface">@color/cp_ink</item>
        <item name="android:colorBackground">@color/cp_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="materialButtonStyle">@style/CpButton</item>
    </style>
    <style
        name="Theme.ClassPulse"
        parent="Base.Theme.ClassPulse"
    />
    <style
        name="CpButton"
        parent="Widget.Material3.Button"
    >
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
