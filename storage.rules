rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ownsSession(sid, uid) {
      let session = firestore.get(/databases/(default)/documents/sessions/$(sid));
      return request.auth != null && request.auth.uid == uid &&
        session.data.ownerUid == uid && session.data.deletedAt == null;
    }
    match /lecture-recordings/{sid}/{uid}/{filename} {
      allow get: if ownsSession(sid, uid);
      allow create: if resource == null && ownsSession(sid, uid) && filename.matches('[a-zA-Z0-9_-]{8,100}[.]m4a') &&
        request.resource.size > 0 && request.resource.size <= 64 * 1024 * 1024 &&
        request.resource.contentType == 'audio/mp4';
    }
  }
}
