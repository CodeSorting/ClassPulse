{
  "name": "classpulse-firebase-workspace",
  "private": true,
  "scripts": {
    "test:server": "firebase emulators:exec --project demo-classpulse --only auth,firestore,functions,storage \"node --test --test-concurrency=1 functions/test/*.test.js\"",
    "emulators": "firebase emulators:start --project demo-classpulse --only auth,firestore,functions,storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "15.34.2"
  }
}
